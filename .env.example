SUPABASE_URL=###
SUPABASE_KEY=###
# Supabase dashboard → Settings → API → service_role. Bypasses RLS; server-only.
# Required for domain-table access (digest/article/cluster) and the integration tests.
SUPABASE_SERVICE_ROLE_KEY=###

# Opt-in for the run-state integration tests, which write to the project above with RLS
# bypassed (synthetic 1970 week windows, purged before and after). Leave unset unless this
# project is safe to write to — the suite skips itself without it.
SUPABASE_TEST_PROJECT=

# F-03: LLM harness. The pipeline worker (plain Node) reads these from .env — NOT from Supabase.
# console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=###
# Hard per-digest spend ceiling in USD. A run that reaches it halts rather than billing on.
# Defaults to 5 if unset. Prices in src/lib/llm/pricing.ts are sticker rates.
LLM_COST_CEILING_USD=5

# Opt-in for the F-03 live smoke test, which makes one real (cheap) Anthropic call to confirm the
# usage/response shape the cost accounting depends on. Leave unset — the suite skips without it.
LLM_LIVE_SMOKE=

# F-02: operator PIN access gate. PIN_HASH is generated by `npm run hash-pin -- <pin> <pepper>`
# — do not type it by hand. PIN_PEPPER is a random secret shared between the hash and the running
# app. SESSION_SECRET signs the session cookie; unrelated to PIN_PEPPER.
PIN_HASH=###
PIN_PEPPER=###
SESSION_SECRET=###

# F-04: email harness (Gmail SMTP). All optional — the worker runs fine without them; no
# pipeline stage calls the harness yet. GMAIL_APP_PASSWORD must be a Gmail App Password, not the
# account password — Google rejects the regular password for SMTP. Generate one at
# https://myaccount.google.com/apppasswords, which requires 2-Step Verification to be enabled on
# the sending account first. OPERATOR_EMAIL is the fixed single-operator recipient.
GMAIL_USER=###
GMAIL_APP_PASSWORD=###
OPERATOR_EMAIL=###

# S-04: where the operator reaches the dashboard, used for the link in the FR-010 "digest ready
# for selection" email. This is the Cloudflare Tunnel hostname in production (http://localhost:4321
# when testing locally). Optional — without it the email still lists the shortlist, just with no
# button, rather than one pointing nowhere.
DASHBOARD_BASE_URL=###

# Opt-in for the F-04 live smoke test, which sends one real email via Gmail SMTP to confirm the
# harness works against the real provider. Leave unset — the suite skips without it.
EMAIL_LIVE_SMOKE=

# S-06: Google Slides rendering (FR-015). All optional — the worker collects, ranks and generates
# fine without them; only `npm run visuals` and `npm run visuals:validate` need them.
#
# Canva was the intended tool here and is NOT usable: its Autofill API requires the acting user to
# be a member of a Canva Enterprise organization, for autofilling a plain design as much as a brand
# template. Google Slides gives the same "operator owns the design, code fills named slots" shape
# for free.
#
# Setup:
#   1. Google Cloud console -> new project -> enable the Google Slides API.
#   2. Create a service account, then a JSON key for it. No roles are needed: it reaches the decks
#      purely through Drive sharing, not IAM.
#   3. Base64 the whole JSON file into GOOGLE_SA_PRIVATE_KEY_B64. Base64 rather than raw PEM
#      because a PEM contains literal newlines, and dotenv has already mangled a secret in this
#      project once (PIN_PEPPER, truncated at a `#`).
#        Linux/macOS:  base64 -w0 service-account.json
#        PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   4. Share BOTH template decks with GOOGLE_SA_EMAIL as **Editor** — the worker duplicates and
#      deletes slides inside them. Without Editor it can only read.
#   5. Run `npm run visuals:validate` to confirm the decks match the spec before the first render.
#      See context/changes/brand-visual-assets/template-spec.md.
GOOGLE_SA_EMAIL=###
GOOGLE_SA_PRIVATE_KEY_B64=###

# The presentation id is the part of the Slides URL between /d/ and /edit:
#   https://docs.google.com/presentation/d/<THIS PART>/edit
SLIDES_DECK_SINGLE_POST=###
SLIDES_DECK_CAROUSEL=###

# Where rendered PNGs are stored. Created by migration 20260908140000; override only if you
# renamed the bucket.
SUPABASE_ASSET_BUCKET=digest-assets
