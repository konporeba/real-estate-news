SUPABASE_URL=###
SUPABASE_KEY=###
# Supabase dashboard → Settings → API → service_role. Bypasses RLS; server-only.
# Required for domain-table access (digest/article/cluster) and the integration tests.
SUPABASE_SERVICE_ROLE_KEY=###

# Opt-in for the run-state integration tests, which write to the project above with RLS
# bypassed (synthetic 1970 week windows, purged before and after). Leave unset unless this
# project is safe to write to — the suite skips itself without it.
SUPABASE_TEST_PROJECT=

# F-03: LLM harness. The pipeline worker (plain Node) reads these from .env — NOT from Supabase.
# console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=###
# Hard per-digest spend ceiling in USD. A run that reaches it halts rather than billing on.
# Defaults to 5 if unset. Prices in src/lib/llm/pricing.ts are sticker rates.
LLM_COST_CEILING_USD=5

# Opt-in for the F-03 live smoke test, which makes one real (cheap) Anthropic call to confirm the
# usage/response shape the cost accounting depends on. Leave unset — the suite skips without it.
LLM_LIVE_SMOKE=
