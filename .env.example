SUPABASE_URL=###
SUPABASE_KEY=###
# Supabase dashboard → Settings → API → service_role. Bypasses RLS; server-only.
# Required for domain-table access (digest/article/cluster) and the integration tests.
SUPABASE_SERVICE_ROLE_KEY=###

# Opt-in for the run-state integration tests, which write to the project above with RLS
# bypassed (synthetic 1970 week windows, purged before and after). Leave unset unless this
# project is safe to write to — the suite skips itself without it.
SUPABASE_TEST_PROJECT=

# F-03: LLM harness. The pipeline worker (plain Node) reads these from .env — NOT from Supabase.
# console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=###
# Hard per-digest spend ceiling in USD. A run that reaches it halts rather than billing on.
# Defaults to 5 if unset. Prices in src/lib/llm/pricing.ts are sticker rates.
LLM_COST_CEILING_USD=5

# Opt-in for the F-03 live smoke test, which makes one real (cheap) Anthropic call to confirm the
# usage/response shape the cost accounting depends on. Leave unset — the suite skips without it.
LLM_LIVE_SMOKE=

# F-02: operator PIN access gate. PIN_HASH is generated by `npm run hash-pin -- <pin> <pepper>`
# — do not type it by hand. PIN_PEPPER is a random secret shared between the hash and the running
# app. SESSION_SECRET signs the session cookie; unrelated to PIN_PEPPER.
PIN_HASH=###
PIN_PEPPER=###
SESSION_SECRET=###

# F-04: email harness (Gmail SMTP). All optional — the worker runs fine without them; no
# pipeline stage calls the harness yet. GMAIL_APP_PASSWORD must be a Gmail App Password, not the
# account password — Google rejects the regular password for SMTP. Generate one at
# https://myaccount.google.com/apppasswords, which requires 2-Step Verification to be enabled on
# the sending account first. OPERATOR_EMAIL is the fixed single-operator recipient.
GMAIL_USER=###
GMAIL_APP_PASSWORD=###
OPERATOR_EMAIL=###

# Opt-in for the F-04 live smoke test, which sends one real email via Gmail SMTP to confirm the
# harness works against the real provider. Leave unset — the suite skips without it.
EMAIL_LIVE_SMOKE=
