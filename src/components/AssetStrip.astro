---
export interface RenderedAsset {
  slideIndex: number;
  url: string;
  label: string;
}

interface Props {
  assets: RenderedAsset[];
  partialFailure?: boolean;
}

const { assets, partialFailure = false } = Astro.props;
---

<section aria-labelledby="slides-title" class="flex flex-col gap-4">
  <h2 id="slides-title" class="text-[22px] font-bold tracking-tight">
    The slides <span class="text-muted-foreground font-normal">({assets.length})</span>
  </h2>

  {
    partialFailure && (
      <p role="alert" class="border-destructive bg-destructive-tint text-destructive rounded-2xl border p-4 text-sm">
        Some slides couldn't be loaded. Re-run <code class="font-mono">npm run visuals</code> for this digest.
      </p>
    )
  }

  {/* A swipeable row, like the carousel itself: no script, so it works the same on a phone. */}
  <ul class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
    {
      assets.map((asset) => (
        <li class="bg-card w-[min(78vw,340px)] shrink-0 snap-start overflow-hidden rounded-2xl border">
          {/* Square by construction: the templates are 1080x1080 and the validator fails a deck
              that is not. aspect-square here means a wrong-sized export is visibly letterboxed
              rather than silently stretched. */}
          <img
            src={asset.url}
            alt={`Slide ${String(asset.slideIndex + 1)}: ${asset.label}`}
            width="1080"
            height="1080"
            loading="lazy"
            class="bg-primary aspect-square w-full object-contain"
          />
          <div class="space-y-0.5 px-4 py-3">
            <p class="text-muted-foreground font-mono text-[12px]">Slide {asset.slideIndex + 1}</p>
            <p class="line-clamp-2 text-sm leading-snug font-medium">{asset.label}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
