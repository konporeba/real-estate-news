---
import { PLATFORM_LABELS } from "@/lib/selection/rules";
import { cn } from "@/lib/utils";
import type { SelectionPlatform } from "@/types";

export interface PublicationResultRow {
  platform: SelectionPlatform;
  status: "success" | "failure";
  postId: string | null;
  error: string | null;
}

interface Props {
  results: PublicationResultRow[];
}

const { results } = Astro.props;
---

{
  results.length > 0 && (
    <section aria-labelledby="results-title" class="flex flex-col gap-3">
      <h2 id="results-title" class="text-[22px] font-bold tracking-tight">
        Publish results
      </h2>
      <ul class="bg-card overflow-hidden rounded-2xl border">
        {results.map((result) => (
          <li class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b px-5 py-4 last:border-b-0">
            <span class="min-w-28 font-semibold">{PLATFORM_LABELS[result.platform]}</span>
            <span
              class:list={cn(
                "inline-flex h-7 items-center rounded-full px-3 text-[13px]",
                result.status === "success"
                  ? "bg-primary text-primary-foreground font-medium"
                  : "border-destructive bg-destructive-tint text-destructive border font-semibold",
              )}
            >
              {result.status === "success" ? "Posted" : "Failed"}
            </span>
            <span
              class:list={cn(
                "min-w-0 flex-1 text-sm",
                result.status === "success" ? "text-muted-foreground font-mono" : "text-destructive",
              )}
            >
              {result.status === "success" ? `Post id ${result.postId ?? "not recorded"}` : result.error}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}
