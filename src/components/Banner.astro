---
import { cn } from "@/lib/utils";

type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div
  class:list={cn(
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:text-inherit [&_a]:underline",
    variant === "error" && "border-destructive bg-destructive-tint text-destructive",
    variant === "warning" && "border-foreground bg-card text-foreground",
    variant === "info" && "border-signal bg-signal-tint text-foreground",
  )}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
