---
import { isSafeUrl } from "@/lib/utils";
import type { ApprovalStory } from "@/types";

const LANGUAGE_CHIP =
  "shrink-0 rounded border border-input px-1.5 py-px text-[11px] font-bold tracking-wider text-foreground";

interface Props {
  story: ApprovalStory;
  index: number;
  total: number;
}

const { story, index, total } = Astro.props;
---

<li class="bg-card flex flex-wrap gap-6 rounded-[20px] border p-6 sm:p-7">
  <div class="flex min-w-0 flex-[999_1_420px] flex-col gap-3.5">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="text-muted-foreground text-[13px] font-semibold tracking-[0.08em] uppercase">
        Story {index} of {total}
      </span>
      {
        story.sourceTextOrigin === "lede" && (
          <span
            class="border-input inline-flex h-6.5 items-center rounded-full border border-dashed px-2.5 text-[13px]"
            title="The source page couldn't be read in full, so this copy was written from the article's opening paragraph only."
          >
            Written from the opening paragraph only
          </span>
        )
      }
    </div>
    <h3 class="text-2xl leading-tight font-bold tracking-tight">{story.polishTitle}</h3>
    <p class="text-base leading-relaxed font-medium">{story.captionSummary}</p>
    <p class="text-foreground/85 text-base leading-relaxed whitespace-pre-wrap">{story.bodyCopy}</p>
  </div>

  <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-4">
    <div class="overflow-hidden rounded-2xl border">
      {
        story.keyStatistics.length > 0 ? (
          <Fragment>
            <p class="bg-signal-tint flex items-center gap-2 px-4 py-3 text-sm font-semibold">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              Figures checked against the source
            </p>
            <dl class="px-4 pb-2">
              {story.keyStatistics.map((stat) => (
                <div class="flex items-baseline justify-between gap-3 border-b py-2.5 text-sm last:border-b-0">
                  <dt class="text-muted-foreground">{stat.label}</dt>
                  <dd class="text-right font-mono font-medium">{stat.value}</dd>
                </div>
              ))}
            </dl>
          </Fragment>
        ) : (
          <p class="text-muted-foreground px-4 py-3 text-sm">No figures in this story.</p>
        )
      }
    </div>

    <div class="bg-muted flex flex-col gap-2 rounded-2xl p-4">
      <p class="text-muted-foreground text-[13px] font-semibold tracking-[0.08em] uppercase">Source</p>
      {
        story.originalTitle ? (
          <Fragment>
            <div class="flex items-baseline gap-2">
              {story.language && <span class:list={LANGUAGE_CHIP}>{story.language.toUpperCase()}</span>}
              <p class="text-sm leading-snug font-medium">{story.originalTitle}</p>
            </div>
            {story.originalLede && <p class="text-muted-foreground text-sm leading-snug">{story.originalLede}</p>}
          </Fragment>
        ) : (
          <p class="text-muted-foreground text-sm">The original article isn't available.</p>
        )
      }
      {
        story.sourceUrl && isSafeUrl(story.sourceUrl) && (
          <a
            href={story.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center self-start text-sm font-semibold no-underline hover:underline"
          >
            Open the source article
          </a>
        )
      }
    </div>
  </div>
</li>
