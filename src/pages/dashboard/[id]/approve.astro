---
// S-07: the content approval gate (FR-019, FR-020, US-16) — the operator reviews the complete
// generated post here and approves or rejects it. A dedicated route rather than a sixth branch on
// the digest page (`../[id].astro`), per the plan's own review: that page is already 318 lines
// with five query branches, and S-04's impl-review found a crash born of exactly that
// accumulation (a query error that set a flag without returning).
import GeneratedStoryCard from "@/components/GeneratedStoryCard.astro";
import AssetStrip, { type RenderedAsset } from "@/components/AssetStrip.astro";
import { ApprovalPanel } from "@/components/ApprovalPanel";
import { StoryEditor } from "@/components/StoryEditor";
import AppHeader from "@/components/AppHeader.astro";
import Notice from "@/components/Notice.astro";
import StatusChip from "@/components/StatusChip.astro";
import { PublishPanel } from "@/components/PublishPanel";
import PublicationResults, { type PublicationResultRow } from "@/components/PublicationResults.astro";
import Layout from "@/layouts/Layout.astro";
import { formatWeek } from "@/lib/digest/presentation";
import { FORMAT_LABELS, PLATFORM_LABELS } from "@/lib/selection/rules";
import { ASSET_BUCKET, SIGNED_URL_TTL_SECONDS } from "@/lib/digest/assets";
import { isPublishingEnabled } from "@/lib/publishing-admin";
import { createServiceClient } from "@/lib/supabase-admin";
import { cn } from "@/lib/utils";
import type {
  ApprovalDecision,
  ApprovalStory,
  DigestStatus,
  KeyStatistic,
  SelectionFormat,
  SelectionPlatform,
  SourceTextOrigin,
} from "@/types";

/**
 * Statuses this page can show generated content for. Anything earlier means generation has not
 * produced anything yet; `failed` gets its own diagnostic branch below, matching `[id].astro`'s
 * convention of keeping "not ready" and "broke" visibly distinct. Extended in S-08 to also cover
 * `skipped` and `published`: this page is now also where the operator publishes manually (S-08's
 * own manual-publish and results-viewing statuses), not just where they decide.
 */
const CONTENT_STATUSES: DigestStatus[] = ["ready_for_approval", "approved", "rejected", "skipped", "published"];

/** Statuses S-08's "Publish now" panel is offered for — a live decision has already been made. */
const PUBLISHABLE_STATUSES: DigestStatus[] = ["approved", "skipped"];

/** Statuses a `publication` row can legally exist for — record_publication's own contract. */
const HAS_PUBLICATION_STATUSES: DigestStatus[] = ["approved", "skipped", "published"];

interface DigestSummary {
  id: string;
  window_start: string;
  window_end: string;
  status: DigestStatus;
  last_error: string | null;
}

const { id } = Astro.params;
const client = createServiceClient();

let loadError = false;
let digest: DigestSummary | null = null;

if (client) {
  const { data, error } = await client
    .from("digest")
    .select("id, window_start, window_end, status, last_error")
    .eq("id", id)
    .maybeSingle();
  if (error) {
    console.error(`failed to load digest ${id}: ${error.code}: ${error.message}`);
    loadError = true;
    Astro.response.status = 500;
  } else {
    digest = data;
    if (!digest) Astro.response.status = 404;
  }
} else {
  Astro.response.status = 503;
}

let stories: ApprovalStory[] = [];
/** Titles of picked stories whose copy could not be produced safely, so they were left out. */
let notIncluded: string[] = [];
let selection: { format: SelectionFormat; platforms: SelectionPlatform[] } | null = null;
let decided: { decision: ApprovalDecision; note: string | null; decidedAt: string } | null = null;
let publications: PublicationResultRow[] = [];

if (client && digest && !loadError && CONTENT_STATUSES.includes(digest.status)) {
  const { data: copyRows, error: copyError } = await client
    .from("generated_copy")
    .select("cluster_id, polish_title, caption_summary, body_copy, key_statistics, source_text_origin")
    .eq("digest_id", digest.id)
    .order("created_at", { ascending: true });
  if (copyError) {
    console.error(`failed to load generated copy for digest ${digest.id}: ${copyError.code}: ${copyError.message}`);
    loadError = true;
    Astro.response.status = 500;
  }

  const clusterIds = (copyRows ?? []).map((row) => row.cluster_id);

  const { data: articles, error: articlesError } =
    clusterIds.length > 0
      ? await client
          .from("article")
          .select("cluster_id, original_title, original_lede, source_url, language, published_at")
          .in("cluster_id", clusterIds)
          .order("published_at", { ascending: true })
      : { data: [], error: null };
  if (articlesError) {
    console.error(
      `failed to load source articles for digest ${digest.id}: ${articlesError.code}: ${articlesError.message}`,
    );
    loadError = true;
    Astro.response.status = 500;
  }

  // First by published_at ascending wins -- deterministic, and matches [id].astro's own
  // "earliest published" fallback when nothing else distinguishes a multi-source story's articles.
  const articleByCluster = new Map<string, NonNullable<typeof articles>[number]>();
  for (const article of articles ?? []) {
    if (!article.cluster_id) continue;
    if (!articleByCluster.has(article.cluster_id)) articleByCluster.set(article.cluster_id, article);
  }

  // generated_copy already covers only the PICKED clusters (S-05: one row per selected cluster,
  // not per shortlisted one), so no separate selection_item.picked filter is needed here.
  stories = (copyRows ?? []).map((row): ApprovalStory => {
    const article = articleByCluster.get(row.cluster_id);
    return {
      clusterId: row.cluster_id,
      polishTitle: row.polish_title,
      captionSummary: row.caption_summary,
      bodyCopy: row.body_copy,
      keyStatistics: row.key_statistics as unknown as KeyStatistic[],
      sourceTextOrigin: row.source_text_origin as SourceTextOrigin,
      originalTitle: article?.original_title ?? null,
      originalLede: article?.original_lede ?? null,
      sourceUrl: article?.source_url ?? null,
      language: article?.language ?? null,
    };
  });

  const { data: selectionRow, error: selectionError } = await client
    .from("selection")
    .select("format, platforms, selection_item(cluster_id, picked)")
    .eq("digest_id", digest.id)
    .maybeSingle();

  // Picked stories the generation stage left out (resilient-story-generation): picked, but no copy
  // row. Read-only and best-effort — a failure here hides the notice, it does not block approval.
  const generatedIds = new Set(clusterIds);
  const leftOutIds = (selectionRow?.selection_item ?? [])
    .filter((item) => item.picked && !generatedIds.has(item.cluster_id))
    .map((item) => item.cluster_id);
  if (leftOutIds.length > 0) {
    const { data: leftOutArticles, error: leftOutError } = await client
      .from("article")
      .select("cluster_id, original_title, polish_title")
      .in("cluster_id", leftOutIds)
      .order("published_at", { ascending: true });
    if (leftOutError) {
      console.error(`failed to load left-out stories for digest ${digest.id}: ${leftOutError.message}`);
    } else {
      notIncluded = leftOutIds.map((clusterId) => {
        const clusterArticles = leftOutArticles.filter((article) => article.cluster_id === clusterId);
        const article = clusterArticles.find((a) => a.polish_title) ?? clusterArticles.at(0);
        return article?.polish_title ?? article?.original_title ?? "A picked story";
      });
    }
  }
  if (selectionError) {
    console.error(
      `failed to load selection for digest ${digest.id}: ${selectionError.code}: ${selectionError.message}`,
    );
    loadError = true;
    Astro.response.status = 500;
  } else if (selectionRow) {
    selection = { format: selectionRow.format, platforms: selectionRow.platforms };
  }

  if (digest.status === "approved" || digest.status === "rejected") {
    const { data: approvalRow, error: approvalError } = await client
      .from("approval")
      .select("decision, note, decided_at")
      .eq("digest_id", digest.id)
      .maybeSingle();
    if (approvalError) {
      console.error(
        `failed to load the approval record for digest ${digest.id}: ${approvalError.code}: ${approvalError.message}`,
      );
      loadError = true;
      Astro.response.status = 500;
    } else if (approvalRow) {
      decided = { decision: approvalRow.decision, note: approvalRow.note, decidedAt: approvalRow.decided_at };
    }
  }

  if (HAS_PUBLICATION_STATUSES.includes(digest.status)) {
    const { data: publicationRows, error: publicationError } = await client
      .from("publication")
      .select("platform, status, post_id, error")
      .eq("digest_id", digest.id);
    if (publicationError) {
      console.error(
        `failed to load publication results for digest ${digest.id}: ${publicationError.code}: ${publicationError.message}`,
      );
      loadError = true;
      Astro.response.status = 500;
    } else {
      publications = publicationRows.map((row) => ({
        platform: row.platform,
        status: row.status,
        postId: row.post_id,
        error: row.error,
      }));
    }
  }
}

/**
 * Rendered slide images (S-06). Three outcomes kept apart on purpose, exactly as `[id].astro`
 * does — S-03 impl-review F2 is why this project never conflates "nothing loaded", "some loaded",
 * and "the stage hasn't run yet".
 */
let assets: RenderedAsset[] = [];
let assetsError = false;
let assetsPartial = false;

if (client && digest && !loadError && CONTENT_STATUSES.includes(digest.status)) {
  const { data: rows, error: assetsQueryError } = await client
    .from("generated_asset")
    .select("slide_index, cluster_id, storage_path, width, height")
    .eq("digest_id", digest.id)
    .order("slide_index", { ascending: true });

  if (assetsQueryError) {
    console.error(
      `failed to load assets for digest ${digest.id}: ${assetsQueryError.code}: ${assetsQueryError.message}`,
    );
    assetsError = true;
  } else if (rows.length > 0) {
    const { data: signed, error: signError } = await client.storage.from(ASSET_BUCKET).createSignedUrls(
      rows.map((row) => row.storage_path),
      SIGNED_URL_TTL_SECONDS,
    );

    if (signError) {
      console.error(`failed to sign asset URLs for digest ${digest.id}: ${signError.message}`);
      assetsError = true;
    } else {
      const failed = signed.filter((entry) => !entry.signedUrl);
      if (failed.length > 0) {
        console.error(
          `failed to sign ${String(failed.length)}/${String(signed.length)} asset URL(s) for digest ${digest.id} ` +
            `in bucket ${ASSET_BUCKET}: ${failed[0]?.error ?? "no reason given"}`,
        );
      }

      const urlByPath = new Map(
        signed.filter((entry) => entry.signedUrl).map((entry) => [entry.path, entry.signedUrl]),
      );
      const titleByCluster = new Map(stories.map((story) => [story.clusterId, story.polishTitle]));

      assets = rows.flatMap((row): RenderedAsset[] => {
        const url = urlByPath.get(row.storage_path);
        if (!url) {
          assetsPartial = true;
          return [];
        }
        return [
          {
            slideIndex: row.slide_index,
            url,
            width: row.width,
            height: row.height,
            label: row.cluster_id ? (titleByCluster.get(row.cluster_id) ?? "Story") : "Cover",
          },
        ];
      });

      if (assets.length === 0) {
        assetsError = true;
        assetsPartial = false;
      }
    }
  }
}
---

<Layout title={digest ? `Approve · ${formatWeek(digest.window_start, digest.window_end)}` : "Digest not found"}>
  <AppHeader
    back={{ href: digest ? `/dashboard/${digest.id}` : "/dashboard", label: "This week" }}
    context={digest?.status === "ready_for_approval" ? "Step 2 of 2 · Approve" : undefined}
  />
  <main
    class:list={cn(
      "mx-auto flex max-w-6xl flex-col gap-7 px-4 pt-9 sm:px-6",
      // Room for the fixed decision bar, so it never covers the last story.
      digest?.status === "ready_for_approval" ? "pb-44" : "pb-16",
    )}
  >
    {
      digest && (
        <div class="space-y-2">
          <h1 class="text-3xl leading-tight font-bold tracking-tight sm:text-[34px]">
            {digest.status === "ready_for_approval"
              ? "Is this ready to go out?"
              : `Week of ${formatWeek(digest.window_start, digest.window_end)}`}
          </h1>
          <div class="text-muted-foreground flex flex-wrap items-center gap-2.5 text-base">
            {digest.status !== "ready_for_approval" && <StatusChip status={digest.status} />}
            <span>
              {formatWeek(digest.window_start, digest.window_end)}
              {selection &&
                ` · ${FORMAT_LABELS[selection.format]}, ${String(stories.length)} ${stories.length === 1 ? "story" : "stories"} · ${selection.platforms.map((p) => PLATFORM_LABELS[p]).join(", ")}`}
            </span>
          </div>
        </div>
      )
    }
    {
      !client ? (
        <Notice>Supabase is not configured — this digest cannot be loaded.</Notice>
      ) : loadError ? (
        <Notice tone="problem">Couldn't load this digest — please try again.</Notice>
      ) : !digest ? (
        <Notice>No digest with this id exists.</Notice>
      ) : digest.status === "failed" ? (
        <Notice tone="problem">
          <p class="font-semibold">This week's run stopped before it finished.</p>
          <p class="mt-1">{digest.last_error ?? "No diagnostic was recorded."}</p>
        </Notice>
      ) : digest.status === "rendering" ? (
        <Notice>
          <p class="font-semibold">The slides are being drawn.</p>
          <p class="text-muted-foreground mt-1">
            If you just edited the text, it's saved and the slides are being redrawn with it. This starts within 5
            minutes and takes a few more; you'll get the approval email when it's ready.
          </p>
        </Notice>
      ) : !CONTENT_STATUSES.includes(digest.status) ? (
        <Notice>
          There's nothing to review yet — this week is at <span class="font-semibold">{digest.status}</span>. You'll get
          an email when the post is ready.
        </Notice>
      ) : stories.length === 0 ? (
        <Notice>No generated stories were found for this week.</Notice>
      ) : (
        <Fragment>
          {decided && (
            <Notice tone={decided.decision === "approved" ? "turn" : "neutral"}>
              <p>
                <span class="font-semibold">
                  {decided.decision === "approved" ? "You approved this post" : "You sent this post back"}
                </span>{" "}
                on {new Date(decided.decidedAt).toLocaleString("en-GB", { timeZone: "Europe/Warsaw" })}.
                {decided.decision === "approved" &&
                  digest.status === "approved" &&
                  " It publishes on Tuesday at 17:00."}
              </p>
              {decided.note && <p class="text-muted-foreground mt-1">Your note: {decided.note}</p>}
              {decided.decision === "rejected" && (
                <p class="text-muted-foreground mt-2">
                  To get fresh copy on the same picks, open the week and choose Manage week → Retry.
                </p>
              )}
            </Notice>
          )}

          {notIncluded.length > 0 && (
            <Notice>
              <p class="font-semibold">Not included</p>
              <p class="text-muted-foreground mt-1">
                {notIncluded.length === 1 ? "This story was" : "These stories were"} left out because its copy couldn't
                be produced safely — either the figure check failed or the AI service failed on it. The rest of the week
                went ahead. To try again, send the post back, then choose Manage week → Retry on the week page.
              </p>
              <ul class="mt-2 list-disc pl-5">
                {notIncluded.map((title) => (
                  <li>{title}</li>
                ))}
              </ul>
            </Notice>
          )}

          {PUBLISHABLE_STATUSES.includes(digest.status) && selection && (
            <PublishPanel
              client:load
              digestId={digest.id}
              platforms={selection.platforms}
              testMode={!isPublishingEnabled()}
            />
          )}

          <PublicationResults results={publications} />

          {assetsError ? (
            <Notice tone="problem">
              Couldn't load this week's slides — the images may still exist. Try reloading.
            </Notice>
          ) : assets.length > 0 ? (
            <AssetStrip assets={assets} partialFailure={assetsPartial} />
          ) : (
            <Notice>The slides haven't been designed yet.</Notice>
          )}

          <section aria-labelledby="stories-title" class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 id="stories-title" class="text-[22px] font-bold tracking-tight">
                The copy
              </h2>
              {digest.status === "ready_for_approval" && selection && (
                <StoryEditor
                  client:load
                  digestId={digest.id}
                  format={selection.format}
                  stories={stories.map((story) => ({
                    clusterId: story.clusterId,
                    polishTitle: story.polishTitle,
                    captionSummary: story.captionSummary,
                  }))}
                />
              )}
            </div>
            <ol class="flex flex-col gap-4">
              {stories.map((story, i) => (
                <GeneratedStoryCard story={story} index={i + 1} total={stories.length} />
              ))}
            </ol>
          </section>

          {digest.status === "ready_for_approval" && selection && (
            <ApprovalPanel
              client:load
              digestId={digest.id}
              storyCount={stories.length}
              format={selection.format}
              platforms={selection.platforms}
            />
          )}
        </Fragment>
      )
    }
  </main>
</Layout>
