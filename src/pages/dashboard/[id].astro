---
import Layout from "@/layouts/Layout.astro";
import AssetStrip, { type RenderedAsset } from "@/components/AssetStrip.astro";
import OperatorHeader from "@/components/OperatorHeader.astro";
import { SelectionForm } from "@/components/SelectionForm";
import { ShortlistCard } from "@/components/ShortlistCard";
import { ASSET_BUCKET, SIGNED_URL_TTL_SECONDS } from "@/lib/digest/assets";
import { FORMAT_LABELS, PLATFORM_LABELS } from "@/lib/selection/rules";
import { createServiceClient } from "@/lib/supabase-admin";
import type { DigestStatus, SelectionFormat, SelectionPlatform, ShortlistItem } from "@/types";

/** Statuses reached before the ranking stage (and its translation sub-step) has run. */
const NOT_READY_STATUSES: DigestStatus[] = ["collecting", "ranking"];

/**
 * Statuses at or past the rendering stage — the ones whose digest may have images to show.
 * `failed` is absent deliberately: that status renders its own diagnostic panel instead, and a
 * half-rendered set behind a failure message would invite the operator to read it as finished.
 * `rejected` (S-07) IS included: a rejected digest still has the visuals it was rejected with,
 * and omitting it would make the cards it really does have vanish with no explanation.
 */
const RENDERED_STATUSES: DigestStatus[] = ["rendering", "ready_for_approval", "approved", "rejected", "published"];

interface DigestSummary {
  id: string;
  window_start: string;
  window_end: string;
  status: DigestStatus;
  last_error: string | null;
}

const { id } = Astro.params;
const client = createServiceClient();

let loadError = false;
let digest: DigestSummary | null = null;

if (client) {
  const { data, error } = await client
    .from("digest")
    .select("id, window_start, window_end, status, last_error")
    .eq("id", id)
    .maybeSingle();
  if (error) {
    console.error(`failed to load digest ${id}: ${error.code}: ${error.message}`);
    loadError = true;
    Astro.response.status = 500;
  } else {
    digest = data;
    if (!digest) Astro.response.status = 404;
  }
} else {
  Astro.response.status = 503;
}

let shortlist: ShortlistItem[] = [];

/** The confirmed selection, when this digest is past the gate. Null while selection is open. */
let selection: { format: SelectionFormat; platforms: SelectionPlatform[] } | null = null;
let pickedClusterIds = new Set<string>();

if (client && digest && !NOT_READY_STATUSES.includes(digest.status) && digest.status !== "failed") {
  const { data: clusters, error: clustersError } = await client
    .from("cluster")
    .select("id, rank, coverage_count, scoring_detail")
    .eq("digest_id", digest.id)
    .not("rank", "is", null)
    .order("rank", { ascending: true });
  if (clustersError) {
    console.error(
      `failed to load shortlist clusters for digest ${digest.id}: ${clustersError.code}: ${clustersError.message}`,
    );
    loadError = true;
    Astro.response.status = 500;
  }

  const clusterIds = (clusters ?? []).map((c) => c.id);

  const { data: articles, error: articlesError } =
    clusterIds.length > 0
      ? await client
          .from("article")
          .select(
            "id, cluster_id, source_url, published_at, original_title, original_lede, polish_title, polish_summary, language",
          )
          .in("cluster_id", clusterIds)
          .order("published_at", { ascending: true })
      : { data: [], error: null };
  if (articlesError) {
    console.error(
      `failed to load shortlist articles for digest ${digest.id}: ${articlesError.code}: ${articlesError.message}`,
    );
    loadError = true;
    Astro.response.status = 500;
  }

  const articlesByCluster = new Map<string, NonNullable<typeof articles>>();
  for (const article of articles ?? []) {
    if (!article.cluster_id) continue;
    const list = articlesByCluster.get(article.cluster_id) ?? [];
    list.push(article);
    articlesByCluster.set(article.cluster_id, list);
  }

  shortlist = (clusters ?? []).flatMap((cluster): ShortlistItem[] => {
    const clusterArticles = articlesByCluster.get(cluster.id) ?? [];
    // The representative is whichever article carries a Polish translation (per translateShortlist's
    // scope, at most one per cluster); a cluster from before this feature shipped falls back to its
    // earliest-published article, still shown in the original language.
    //
    // .at(0) rather than [0], and a flatMap rather than a map: a shortlisted cluster with no
    // articles should not happen (clusters are built from articles), but the article query above
    // can FAIL — and it sets loadError without returning, so this runs with an empty map. Indexing
    // would throw here and replace the 500 view with an unhandled crash. Same call
    // fetchDigestReadyItems in src/worker/rank.ts makes for the identical edge.
    const representative = clusterArticles.find((a) => a.polish_title) ?? clusterArticles.at(0);
    if (!representative) return [];
    const detail = cluster.scoring_detail as { tier?: string; score?: number; rationale?: string } | null;
    const tier = detail?.tier ?? null;
    const score = detail?.score ?? null;
    const rationale = detail?.rationale ?? null;
    return [
      {
        clusterId: cluster.id,
        rank: cluster.rank,
        tier,
        score,
        rationale,
        coverageCount: cluster.coverage_count,
        polishTitle: representative.polish_title,
        polishSummary: representative.polish_summary,
        originalTitle: representative.original_title,
        originalLede: representative.original_lede,
        originalLanguage: representative.language,
        sourceUrl: representative.source_url,
        translated: Boolean(representative.polish_title),
      },
    ];
  });

  // The selection drives which rendering the page shows: its absence is what "the gate is still
  // open" means. A query failure here follows S-03 impl-review F2 — surface it as a distinct
  // failure rather than letting it read as "no selection yet", which would wrongly re-offer an
  // irreversible action on a digest that has already passed the gate.
  const { data: selectionRow, error: selectionError } = await client
    .from("selection")
    .select("id, format, platforms")
    .eq("digest_id", digest.id)
    .maybeSingle();
  if (selectionError) {
    console.error(
      `failed to load selection for digest ${digest.id}: ${selectionError.code}: ${selectionError.message}`,
    );
    loadError = true;
    Astro.response.status = 500;
  } else if (selectionRow) {
    selection = { format: selectionRow.format, platforms: selectionRow.platforms };

    const { data: items, error: itemsError } = await client
      .from("selection_item")
      .select("cluster_id, picked")
      .eq("selection_id", selectionRow.id)
      .eq("picked", true);
    if (itemsError) {
      console.error(
        `failed to load selection items for digest ${digest.id}: ${itemsError.code}: ${itemsError.message}`,
      );
      loadError = true;
      Astro.response.status = 500;
    } else {
      pickedClusterIds = new Set(items.map((item) => item.cluster_id));
    }
  }
}

/**
 * Rendered slide images (S-06), newest-run only — `renderDigest` replaces the whole set per run.
 *
 * Three outcomes are kept apart on purpose, because S-03 impl-review F2 was exactly this mistake
 * one query over: `assetsError` (nothing could be loaded), `assetsPartial` (some images signed,
 * some did not) and an empty list (the stage has not run yet). Conflating any two of them would
 * show the operator a digest that looks either finished or broken when it is neither.
 */
let assets: RenderedAsset[] = [];
let assetsError = false;
let assetsPartial = false;

if (client && digest && !loadError && RENDERED_STATUSES.includes(digest.status)) {
  const { data: rows, error: assetsQueryError } = await client
    .from("generated_asset")
    .select("slide_index, cluster_id, storage_path")
    .eq("digest_id", digest.id)
    .order("slide_index", { ascending: true });

  if (assetsQueryError) {
    console.error(
      `failed to load assets for digest ${digest.id}: ${assetsQueryError.code}: ${assetsQueryError.message}`,
    );
    assetsError = true;
  } else if (rows.length > 0) {
    // One signing call for every path rather than one per image: the bucket is private, so every
    // render has to mint these, and N round trips would put the page's latency on the slide count.
    const { data: signed, error: signError } = await client.storage.from(ASSET_BUCKET).createSignedUrls(
      rows.map((row) => row.storage_path),
      SIGNED_URL_TTL_SECONDS,
    );

    if (signError) {
      console.error(`failed to sign asset URLs for digest ${digest.id}: ${signError.message}`);
      assetsError = true;
    } else {
      // createSignedUrls reports per ENTRY, not at the top level: a missing object — and a bucket
      // that does not exist at all — both come back with `error: null` above and a null `signedUrl`
      // on each row. Verified against the real project, because the obvious reading of the API
      // (a top-level error on a bad bucket) is wrong, and trusting it would have left the failure
      // branch below unreachable.
      const failed = signed.filter((entry) => !entry.signedUrl);
      if (failed.length > 0) {
        console.error(
          `failed to sign ${String(failed.length)}/${String(signed.length)} asset URL(s) for digest ${digest.id} ` +
            `in bucket ${ASSET_BUCKET}: ${failed[0]?.error ?? "no reason given"}`,
        );
      }

      const urlByPath = new Map(
        signed.filter((entry) => entry.signedUrl).map((entry) => [entry.path, entry.signedUrl]),
      );
      // The shortlist is already loaded, so the slide labels come from it rather than from a second
      // query for the same titles.
      const titleByCluster = new Map(shortlist.map((item) => [item.clusterId, item.polishTitle ?? item.originalTitle]));

      assets = rows.flatMap((row): RenderedAsset[] => {
        const url = urlByPath.get(row.storage_path);
        if (!url) {
          // One path failed while others worked — show what loaded, and say so.
          assetsPartial = true;
          return [];
        }
        return [
          {
            slideIndex: row.slide_index,
            url,
            label: row.cluster_id ? (titleByCluster.get(row.cluster_id) ?? "Story") : "Cover",
          },
        ];
      });

      // Every path failed: the bucket is gone, renamed, or no longer readable. That is a total
      // failure reported as one, not "some images are missing" beside an empty grid.
      if (assets.length === 0) {
        assetsError = true;
        assetsPartial = false;
      }
    }
  }
}

/** The gate is open only while the digest awaits selection and none has been recorded. */
const selectionOpen = digest?.status === "ready_for_selection" && !selection && !loadError;
---

<Layout title="Digest">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <OperatorHeader title={digest ? `${digest.window_start} – ${digest.window_end}` : "Digest not found"} />
    <main class="mx-auto mt-6 max-w-3xl">
      {
        !client ? (
          <p class="rounded-xl border border-white/10 bg-white/10 p-6 text-sm text-blue-100/70">
            Supabase is not configured — this digest cannot be loaded.
          </p>
        ) : loadError ? (
          <p class="rounded-xl border border-red-400/30 bg-red-500/10 p-6 text-sm text-red-200">
            Couldn't load this digest — please try again.
          </p>
        ) : !digest ? (
          <p class="rounded-xl border border-white/10 bg-white/10 p-6 text-sm text-blue-100/70">
            No digest with this id exists.
          </p>
        ) : NOT_READY_STATUSES.includes(digest.status) ? (
          <p class="rounded-xl border border-white/10 bg-white/10 p-6 text-sm text-blue-100/70">
            This digest is still <span class="font-semibold">{digest.status}</span> — the shortlist isn't ready yet.
          </p>
        ) : digest.status === "failed" ? (
          <p class="rounded-xl border border-red-400/30 bg-red-500/10 p-6 text-sm text-red-200">
            This digest failed: {digest.last_error ?? "no diagnostic recorded"}
          </p>
        ) : shortlist.length === 0 ? (
          <p class="rounded-xl border border-white/10 bg-white/10 p-6 text-sm text-blue-100/70">
            No shortlisted stories for this digest.
          </p>
        ) : selectionOpen ? (
          <SelectionForm client:load digestId={digest.id} items={shortlist} />
        ) : (
          <Fragment>
            {selection && (
              <p class="mb-4 rounded-xl border border-purple-400/30 bg-purple-500/10 p-4 text-sm text-blue-100/80">
                Selection confirmed — <span class="font-semibold">{pickedClusterIds.size}</span> stories going out as{" "}
                <span class="font-semibold">{FORMAT_LABELS[selection.format]}</span> content for{" "}
                <span class="font-semibold">{selection.platforms.map((p) => PLATFORM_LABELS[p]).join(", ")}</span>.
              </p>
            )}
            {
              // S-07: the approval gate lives on its own route -- this is only the entry point.
              digest.status === "ready_for_approval" ? (
                <p class="mb-4 rounded-xl border border-amber-400/30 bg-amber-500/10 p-4 text-sm text-amber-100">
                  Content is ready for approval.{" "}
                  <a href={`/dashboard/${digest.id}/approve`} class="font-semibold underline hover:no-underline">
                    Review and decide →
                  </a>
                </p>
              ) : digest.status === "approved" || digest.status === "rejected" ? (
                <p class="mb-4 rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
                  This digest was <span class="font-semibold">{digest.status}</span>.{" "}
                  <a href={`/dashboard/${digest.id}/approve`} class="text-blue-300 hover:underline">
                    View the decision →
                  </a>
                </p>
              ) : digest.status === "skipped" ? (
                // S-08/US-19: a missed approval deadline skips the auto-publish but leaves the
                // digest manually publishable -- the "Publish now" panel lives on the approve page.
                <p class="mb-4 rounded-xl border border-amber-400/30 bg-amber-500/10 p-4 text-sm text-amber-100">
                  This digest missed its approval deadline and was skipped.{" "}
                  <a href={`/dashboard/${digest.id}/approve`} class="font-semibold underline hover:no-underline">
                    Publish it manually →
                  </a>
                </p>
              ) : digest.status === "published" ? (
                <p class="mb-4 rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
                  This digest was published.{" "}
                  <a href={`/dashboard/${digest.id}/approve`} class="text-blue-300 hover:underline">
                    View publish results →
                  </a>
                </p>
              ) : null
            }
            {assetsError ? (
              <p class="mb-6 rounded-xl border border-red-400/30 bg-red-500/10 p-4 text-sm text-red-200">
                Couldn't load this digest's rendered visuals — the images may still exist. Try reloading.
              </p>
            ) : assets.length > 0 ? (
              <AssetStrip assets={assets} partialFailure={assetsPartial} />
            ) : (
              RENDERED_STATUSES.includes(digest.status) && (
                <p class="mb-6 rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
                  No visuals rendered yet — run <code class="font-mono">npm run visuals</code> for this digest.
                </p>
              )
            )}
            <ul class="space-y-3">
              {shortlist.map((item) => (
                <ShortlistCard item={item} picked={pickedClusterIds.has(item.clusterId)} />
              ))}
            </ul>
          </Fragment>
        )
      }
    </main>
  </div>
</Layout>
