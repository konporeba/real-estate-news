---
import Layout from "@/layouts/Layout.astro";

const errorParam = Astro.url.searchParams.get("error");
const until = Astro.url.searchParams.get("until");

// The PIN input's pattern is `[0-9]{6}`, never `\d{6}`: Astro drops the backslash when it renders
// the attribute, and the browser then receives `d{6}`, which rejects every real PIN with "Please
// match the requested format" (f53b20c removed the pattern for this; the redesign brought it back).

// Rendered on the server, which runs in UTC on Cloudflare — so the zone is pinned to the operator's
// own (the scheduler's Europe/Warsaw, the same offset as Barcelona) rather than left to the runtime.
const TIME = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" });

let message: string | null = null;
if (errorParam === "locked") {
  const retryAt = until ? new Date(until) : null;
  message =
    retryAt && !Number.isNaN(retryAt.getTime())
      ? `Too many attempts. You can try again at ${TIME.format(retryAt)}.`
      : "Too many attempts. Please try again later.";
} else if (errorParam === "invalid") {
  message = "That PIN didn't match. After 5 wrong tries the desk pauses for 15 minutes.";
}
---

<Layout title="Sign in">
  <div class="flex min-h-screen flex-col lg:flex-row">
    <aside
      class="bg-primary text-primary-foreground flex flex-col justify-between gap-10 p-8 sm:p-12 lg:w-[520px] lg:shrink-0 lg:p-14"
    >
      <div class="flex items-center gap-2.5">
        <span class="bg-card inline-flex size-8 items-center justify-center rounded-[9px]" aria-hidden="true">
          <span class="bg-signal size-3 rounded-[3px]"></span>
        </span>
        <span class="text-[19px] font-bold tracking-tight">Digest Desk</span>
      </div>
      <div class="space-y-4">
        <h1 class="text-3xl leading-tight font-bold tracking-tight sm:text-[42px] sm:leading-[1.08]">
          Spanish property news, ready for your audience every week.
        </h1>
        <p class="text-border text-[17px] leading-relaxed">
          You make two decisions: which stories, and whether the post is right. Everything else is done for you.
        </p>
      </div>
      <p class="text-border hidden items-center gap-2.5 text-sm lg:flex">
        <span class="bg-signal size-2 rounded-full" aria-hidden="true"></span>
        Next collection: Sunday 17:00
      </p>
    </aside>

    <main class="flex flex-1 items-center justify-center p-6 sm:p-14">
      <form method="post" action="/api/auth/verify-pin" class="w-full max-w-sm space-y-6">
        <div class="space-y-2">
          <h2 class="text-[28px] font-bold tracking-tight">Welcome back</h2>
          <p class="text-muted-foreground text-[15px]">Enter your 6-digit PIN to open the desk.</p>
        </div>

        <div class="space-y-2.5">
          <label for="pin" class="block text-sm font-semibold">PIN</label>
          <input
            id="pin"
            type="password"
            inputmode="numeric"
            pattern="[0-9]{6}"
            title="Your PIN is 6 digits."
            maxlength="6"
            name="pin"
            autocomplete="current-password"
            required
            aria-describedby="pin-help"
            aria-invalid={message ? "true" : undefined}
            class:list={[
              "bg-card text-foreground h-15 w-full rounded-xl px-5 font-mono text-[26px] tracking-[0.6em] focus:outline-2 focus:outline-offset-2",
              message ? "border-destructive border-2" : "border-input border",
            ]}
          />
          {
            message ? (
              <p id="pin-help" role="alert" class="text-destructive flex items-start gap-2 text-sm leading-snug">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-px shrink-0"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 8v4" />
                  <path d="M12 16h.01" />
                </svg>
                {message}
              </p>
            ) : (
              <p id="pin-help" class="text-muted-foreground text-sm">
                After 5 wrong tries the desk pauses for 15 minutes.
              </p>
            )
          }
        </div>

        <button
          type="submit"
          class="bg-primary text-primary-foreground min-h-13 w-full cursor-pointer rounded-xl text-base font-semibold transition-opacity hover:opacity-90"
        >
          Open the desk
        </button>
      </form>
    </main>
  </div>
</Layout>
