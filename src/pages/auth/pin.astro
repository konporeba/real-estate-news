---
import Layout from "@/layouts/Layout.astro";

const errorParam = Astro.url.searchParams.get("error");
const until = Astro.url.searchParams.get("until");

let message: string | null = null;
if (errorParam === "locked") {
  const retryAt = until ? new Date(until) : null;
  message =
    retryAt && !Number.isNaN(retryAt.getTime())
      ? `Too many attempts. Try again after ${retryAt.toLocaleTimeString()}.`
      : "Too many attempts. Try again later.";
} else if (errorParam === "invalid") {
  message = "Incorrect PIN.";
}
---

<Layout title="Operator Access">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Operator Access
      </h1>
      {message && <p class="mb-4 text-center text-sm text-red-300">{message}</p>}
      <form method="post" action="/api/auth/verify-pin" class="space-y-4">
        <input
          type="text"
          inputmode="numeric"
          pattern="\d{6}"
          maxlength="6"
          name="pin"
          autocomplete="one-time-code"
          required
          class="w-full rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-center text-lg tracking-[0.5em] text-white"
          placeholder="••••••"
        />
        <button
          type="submit"
          class="w-full rounded-lg bg-purple-500 px-4 py-2 font-semibold text-white transition-colors hover:bg-purple-600"
        >
          Enter
        </button>
      </form>
    </div>
  </div>
</Layout>
