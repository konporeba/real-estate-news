---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import Notice from "@/components/Notice.astro";
import StatusChip from "@/components/StatusChip.astro";
import { currentStepIndex, formatWeek, NEEDS_OPERATOR_STATUSES, PIPELINE_STEPS } from "@/lib/digest/presentation";
import { createServiceClient } from "@/lib/supabase-admin";
import { cn } from "@/lib/utils";
import type { DigestStatus } from "@/types";

const PAGE_SIZE = 25;

type View = "all" | "needs" | "published";
const VIEWS: { id: View; label: string; statuses: DigestStatus[] | null }[] = [
  { id: "all", label: "All", statuses: null },
  { id: "needs", label: "Needs me", statuses: NEEDS_OPERATOR_STATUSES },
  { id: "published", label: "Published", statuses: ["approved", "published"] },
];

interface DigestRow {
  id: string;
  window_start: string;
  window_end: string;
  status: DigestStatus;
  last_error: string | null;
}

const client = createServiceClient();

const viewParam = Astro.url.searchParams.get("view");
const view = VIEWS.find((v) => v.id === viewParam) ?? VIEWS[0];
const beforeParam = Astro.url.searchParams.get("before");
// window_start is a plain date (YYYY-MM-DD); a malformed cursor falls back to the unfiltered
// first page rather than surfacing as a generic query error.
const before = beforeParam && /^\d{4}-\d{2}-\d{2}$/.test(beforeParam) ? beforeParam : null;

let current: DigestRow | null = null;
let shortlistSize: number | null = null;
let digests: DigestRow[] = [];
let loadError = false;
let hasMore = false;

if (client) {
  // The newest digest is "this week", shown as its own card on the first page whatever the filter,
  // because it is the one the operator most often came here to act on.
  if (!before) {
    const { data, error } = await client
      .from("digest")
      .select("id, window_start, window_end, status, last_error")
      .order("window_start", { ascending: false })
      .limit(1)
      .maybeSingle();
    if (error) {
      console.error(`failed to load current digest: ${error.code}: ${error.message}`);
      loadError = true;
    } else {
      current = data;
    }

    if (current?.status === "ready_for_selection") {
      const { count, error: countError } = await client
        .from("cluster")
        .select("id", { count: "exact", head: true })
        .eq("digest_id", current.id)
        .not("rank", "is", null);
      // Only the headline's number depends on this; a failure drops the number, not the card.
      if (countError) console.error(`failed to count shortlist for digest ${current.id}: ${countError.message}`);
      else shortlistSize = count;
    }
  }

  let query = client
    .from("digest")
    .select("id, window_start, window_end, status, last_error")
    .order("window_start", { ascending: false })
    .limit(PAGE_SIZE);
  if (view.statuses) query = query.in("status", view.statuses);
  // Keyset pagination on window_start rather than offset: the list is append-only by week, so a
  // cursor on the last row's own window_start never skips or repeats a digest as new ones arrive.
  if (before) query = query.lt("window_start", before);

  const { data, error } = await query;
  if (error) {
    console.error(`failed to load digests: ${error.code}: ${error.message}`);
    loadError = true;
  } else {
    hasMore = data.length === PAGE_SIZE;
    // The current week already has its own card above the list.
    digests = data.filter((digest) => digest.id !== current?.id);
  }
  if (loadError) Astro.response.status = 500;
} else {
  Astro.response.status = 503;
}

const nextBefore = hasMore ? (digests.at(-1)?.window_start ?? null) : null;
const viewQuery = view.id === "all" ? "" : `&view=${view.id}`;
const olderHref = nextBefore ? `/dashboard?before=${nextBefore}${viewQuery}` : null;

/** What the "this week" card says and where its one button goes, per status. */
function focusFor(digest: DigestRow): { headline: string; body: string; cta?: { href: string; label: string } } {
  const detail = `/dashboard/${digest.id}`;
  const approve = `/dashboard/${digest.id}/approve`;
  switch (digest.status) {
    case "collecting":
    case "ranking":
      return {
        headline: "This week's news is being gathered and ranked.",
        body: "You'll get an email as soon as the shortlist is ready for you.",
      };
    case "ready_for_selection":
      return {
        headline: `${shortlistSize !== null ? `${String(shortlistSize)} stories` : "Stories"} made the shortlist. Choose the 2 to 4 worth posting.`,
        body: "Once you confirm, the copy and slides are written for you. You get one more look before anything is published.",
        cta: { href: detail, label: "Choose stories" },
      };
    case "generating":
    case "rendering":
      return {
        headline: "Your picks are being written up and designed.",
        body: "You'll get an email when the finished post is ready to approve.",
        cta: { href: detail, label: "See your picks" },
      };
    case "ready_for_approval":
      return {
        headline: "The finished post is ready for your review.",
        body: "Check the slides and copy, then approve it or send it back for a rewrite. Nothing is published without your approval.",
        cta: { href: approve, label: "Review the post" },
      };
    case "approved":
      return {
        headline: "Approved and scheduled for Tuesday at 17:00.",
        body: "You can still publish it right away from the post page.",
        cta: { href: approve, label: "View the post" },
      };
    case "published":
      return {
        headline: "This week's post is out.",
        body: "See how each platform's publish went.",
        cta: { href: approve, label: "View publish results" },
      };
    case "rejected":
      return {
        headline: "You sent this week's post back for a rewrite.",
        body: "Nothing was published. Fresh copy can be generated on the same picks, then it comes back for approval.",
        cta: { href: approve, label: "View your decision" },
      };
    case "skipped":
      return {
        headline: "This week's post missed its approval deadline.",
        body: "Nothing was published. You can still review it and publish it by hand.",
        cta: { href: approve, label: "Review and publish" },
      };
    case "failed":
      return {
        headline: "This week's run stopped before it finished.",
        body: digest.last_error ?? "No diagnostic was recorded.",
        cta: { href: detail, label: "See details" },
      };
  }
}

const focus = current ? focusFor(current) : null;
const stepIndex = current ? currentStepIndex(current.status) : null;

/** One-line context for a past week's row. */
function rowNote(digest: DigestRow): string {
  switch (digest.status) {
    case "skipped":
      return "Nothing was published";
    case "failed":
      return digest.last_error ?? "Stopped without a diagnostic";
    case "rejected":
      return "Waiting for a rewrite";
    default:
      return "";
  }
}

const TODAY = new Intl.DateTimeFormat("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
  timeZone: "Europe/Warsaw",
}).format(new Date());
---

<Layout title="This week">
  <AppHeader />
  <main class="mx-auto flex max-w-6xl flex-col gap-8 px-4 pt-10 pb-16 sm:px-6">
    <div class="space-y-1.5">
      <p class="text-muted-foreground text-[15px]">{TODAY}</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {
          current && (current.status === "ready_for_selection" || current.status === "ready_for_approval")
            ? "One decision is waiting for you."
            : "Your weekly digest desk."
        }
      </h1>
    </div>

    {
      !client ? (
        <Notice>Supabase is not configured — digests cannot be loaded.</Notice>
      ) : loadError ? (
        <Notice tone="problem">Couldn't load your digests — please try again.</Notice>
      ) : (
        current &&
        focus && (
          <section aria-labelledby="week-title" class="bg-card flex flex-wrap overflow-hidden rounded-[20px] border">
            <div class="flex min-w-0 flex-[999_1_520px] flex-col gap-5 p-6 sm:p-9">
              <div class="flex flex-wrap items-center gap-2.5">
                <StatusChip status={current.status} />
                <span class="text-muted-foreground text-sm">
                  Week of {formatWeek(current.window_start, current.window_end)}
                </span>
              </div>
              <h2 id="week-title" class="max-w-xl text-2xl leading-tight font-bold tracking-tight sm:text-[30px]">
                {focus.headline}
              </h2>
              <p
                class:list={cn(
                  "max-w-xl text-base leading-relaxed",
                  current.status === "failed" ? "text-destructive" : "text-muted-foreground",
                )}
              >
                {focus.body}
              </p>
              {focus.cta && (
                <a
                  href={focus.cta.href}
                  class="bg-primary text-primary-foreground inline-flex min-h-12 items-center gap-2.5 self-start rounded-xl px-5.5 text-base font-semibold no-underline transition-opacity hover:opacity-90"
                >
                  {focus.cta.label}
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </a>
              )}
            </div>

            {stepIndex !== null && (
              <div class="bg-muted min-w-0 flex-[1_1_300px] border-t p-6 sm:p-9 lg:border-t-0 lg:border-l">
                <h3 class="text-muted-foreground mb-4 text-[13px] font-semibold tracking-[0.08em] uppercase">
                  This week's run
                </h3>
                <ol>
                  {PIPELINE_STEPS.map((step, i) => {
                    const state = i < stepIndex ? "done" : i === stepIndex ? "current" : "upcoming";
                    const last = i === PIPELINE_STEPS.length - 1;
                    return (
                      <li class="flex gap-3.5" aria-current={state === "current" ? "step" : undefined}>
                        <div class="flex flex-col items-center">
                          {state === "done" ? (
                            <span class="bg-primary inline-flex size-5.5 items-center justify-center rounded-full">
                              <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary-foreground"
                                aria-hidden="true"
                              >
                                <path d="M20 6 9 17l-5-5" />
                              </svg>
                            </span>
                          ) : state === "current" ? (
                            <span class="border-signal-tint bg-signal size-5.5 rounded-full border-4" />
                          ) : (
                            <span class="bg-card size-5.5 rounded-full border-2" />
                          )}
                          {!last && (
                            <span
                              class:list={cn(
                                "min-h-4 w-0.5 flex-1",
                                i < stepIndex - 1 ? "bg-primary" : i === stepIndex - 1 ? "bg-signal" : "bg-border",
                              )}
                            />
                          )}
                        </div>
                        <div class:list={cn(!last && "pb-3.5")}>
                          <p
                            class:list={cn(
                              "text-[15px]",
                              state === "current" && "font-bold",
                              state === "done" && "font-semibold",
                              state === "upcoming" && "text-muted-foreground font-medium",
                            )}
                          >
                            {step.label}
                          </p>
                          {state === "current" && (
                            <p class="text-signal-strong text-[13px] font-semibold">
                              {step.operator ? "Waiting for you" : "In progress"}
                            </p>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </div>
            )}
          </section>
        )
      )
    }

    {
      client && !loadError && (
        <section aria-labelledby="archive-title" class="flex flex-col gap-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 id="archive-title" class="text-[22px] font-bold tracking-tight">
              {current ? "Previous weeks" : "All weeks"}
            </h2>
            <nav aria-label="Filter weeks" class="bg-card inline-flex flex-wrap gap-1 rounded-xl border p-1">
              {VIEWS.map((v) => (
                <a
                  href={v.id === "all" ? "/dashboard" : `/dashboard?view=${v.id}`}
                  aria-current={v.id === view.id ? "page" : undefined}
                  class:list={cn(
                    "inline-flex min-h-9 items-center rounded-lg px-3.5 text-sm no-underline transition-colors",
                    v.id === view.id
                      ? "bg-primary text-primary-foreground font-semibold"
                      : "text-foreground hover:bg-muted font-medium",
                  )}
                >
                  {v.label}
                </a>
              ))}
            </nav>
          </div>

          {digests.length === 0 ? (
            <Notice>
              {view.id === "needs"
                ? "Nothing needs you right now."
                : view.id === "published"
                  ? "Nothing has been published yet."
                  : current
                    ? "No earlier weeks yet."
                    : "No digests yet. The first one is collected on Sunday at 17:00."}
            </Notice>
          ) : (
            <ul class="bg-card overflow-hidden rounded-2xl border">
              {digests.map((digest) => (
                <li class="border-b last:border-b-0">
                  <a
                    href={`/dashboard/${digest.id}`}
                    class="text-foreground hover:bg-muted flex flex-wrap items-center gap-x-6 gap-y-2 px-5 py-4 no-underline transition-colors sm:px-6"
                  >
                    <span class="min-w-0 flex-[1_1_220px]">
                      <span class="block text-base font-semibold">
                        {formatWeek(digest.window_start, digest.window_end)}
                      </span>
                      {rowNote(digest) && (
                        <span
                          class:list={cn(
                            "line-clamp-1 text-[13px]",
                            digest.status === "failed" ? "text-destructive" : "text-muted-foreground",
                          )}
                        >
                          {rowNote(digest)}
                        </span>
                      )}
                    </span>
                    <StatusChip status={digest.status} />
                    <span class="text-signal-strong text-sm font-semibold" aria-hidden="true">
                      Open →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {olderHref && (
            <div class="text-center">
              <a href={olderHref} class="inline-flex min-h-11 items-center px-4 text-sm font-semibold no-underline">
                Show older weeks
              </a>
            </div>
          )}
        </section>
      )
    }
  </main>
</Layout>
