---
import Layout from "@/layouts/Layout.astro";
import OperatorHeader from "@/components/OperatorHeader.astro";
import { createServiceClient } from "@/lib/supabase-admin";

const client = createServiceClient();

let digests: { id: string; window_start: string; window_end: string; status: string }[] = [];
let loadError = false;

if (client) {
  const { data, error } = await client
    .from("digest")
    .select("id, window_start, window_end, status")
    .order("window_start", { ascending: false })
    .limit(25);
  if (error) {
    console.error(`failed to load digests: ${error.code}: ${error.message}`);
    loadError = true;
    Astro.response.status = 500;
  } else {
    digests = data;
  }
} else {
  Astro.response.status = 503;
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <OperatorHeader title="Operator Dashboard" />
    <main class="mx-auto mt-6 max-w-3xl">
      {
        !client ? (
          <p class="rounded-xl border border-white/10 bg-white/10 p-6 text-sm text-blue-100/70">
            Supabase is not configured — digests cannot be loaded.
          </p>
        ) : loadError ? (
          <p class="rounded-xl border border-red-400/30 bg-red-500/10 p-6 text-sm text-red-200">
            Couldn't load digests — please try again.
          </p>
        ) : digests.length === 0 ? (
          <p class="rounded-xl border border-white/10 bg-white/10 p-6 text-sm text-blue-100/70">No digests yet.</p>
        ) : (
          <ul class="space-y-3">
            {digests.map((digest) => (
              <li>
                <a
                  href={`/dashboard/${digest.id}`}
                  class="flex items-center justify-between rounded-xl border border-white/10 bg-white/10 p-4 transition-colors hover:bg-white/20"
                >
                  <span>
                    {digest.window_start} – {digest.window_end}
                  </span>
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs tracking-wide text-blue-100/80 uppercase">
                    {digest.status}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </div>
</Layout>
